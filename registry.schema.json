{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/textbookproject2026-alt/textbook-registry/registry.schema.json",
  "title": "Textbook registry",
  "description": "Structural rules only. Cross-entry rules (uniqueness, slug immutability, collisions between domains, aliases, legacy origins and the portal, preview-only null domains, shared-suffix and dark-state rules, URL canonical form) are enforced by scripts/validate.mjs, because JSON Schema cannot express them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "books"],
  "properties": {
    "schema_version": { "const": 1 },

    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggest_edit_endpoint",
        "cms_auth_relay",
        "cms_auth_relay_scope",
        "edition_extras_repo",
        "console_oauth_client_id",
        "automation_logins"
      ],
      "properties": {
        "suggest_edit_endpoint": { "$ref": "#/$defs/https_url" },
        "cms_auth_relay": {
          "$ref": "#/$defs/https_origin",
          "description": "Used as Sveltia's backend.base_url, which must have no trailing slash and no /callback."
        },
        "cms_auth_relay_scope": {
          "type": "string",
          "pattern": "^[a-z:_]+(,[a-z:_]+)*$",
          "description": "The GitHub OAuth scope the deployed relay requests. A recorded fact, not a setting: the relay decides it, and this records what a contributor's token can do."
        },
        "edition_extras_repo": { "$ref": "#/$defs/repo" },
        "console_oauth_client_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.]{20}$",
          "description": "GitHub OAuth App client ID for the device flow. Public by design; not a secret."
        },
        "automation_logins": {
          "type": "array",
          "items": { "$ref": "#/$defs/github_login" },
          "uniqueItems": true
        },
        "portal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "host", "cms_host", "book_parent"],
          "description": "The portal that lists every book (MULTI-BOOK-HOSTING §2c, §4b, and the 22 Sep note there for `host`, which §4b did not have). Optional until a portal domain is bought.",
          "properties": {
            "domain": {
              "$ref": "#/$defs/hostname",
              "description": "The portal's own address: the apex of a zone the platform holds. Never a book's domain, alias or legacy host."
            },
            "host": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "provider", "project"],
              "description": "Where the portal page is served from. Always `static`: the portal is generated from this file at build time, so no Publish site can ever serve it. No `paid_by` — the portal is the platform's by definition.",
              "properties": {
                "kind": { "const": "static" },
                "provider": { "$ref": "#/$defs/static_provider" },
                "project": { "$ref": "#/$defs/project_name" }
              }
            },
            "cms_host": {
              "oneOf": [{ "$ref": "#/$defs/hostname" }, { "type": "null" }],
              "description": "The shared CMS host, the one exact ALLOWED_DOMAINS entry, once DESIGN step 5b has moved books onto it. null until then."
            },
            "book_parent": {
              "oneOf": [{ "$ref": "#/$defs/hostname" }, { "type": "null" }],
              "description": "New books get <slug>.<book_parent>. Any book hostname under it must be exactly one label deep, to stay inside Universal SSL."
            }
          }
        }
      }
    },

    "books": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/book" }
    }
  },

  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "hostname": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+([a-z]{2,63}|xn--[a-z0-9-]{1,59})$",
      "description": "Lower-case ASCII host, IDNs as punycode. No scheme, port, path, wildcard or trailing dot."
    },
    "https_origin": {
      "type": "string",
      "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+([a-z]{2,63}|xn--[a-z0-9-]{1,59})$",
      "description": "https:// plus a hostname. No port, path or trailing slash."
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+([a-z]{2,63}|xn--[a-z0-9-]{1,59})(/[A-Za-z0-9._~%!$&'()*+,;=:@-]+)*/?$",
      "description": "https URL with no port, query, fragment or credentials."
    },
    "github_login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](-?[A-Za-z0-9]){0,38}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](-?[A-Za-z0-9]){0,38}/[A-Za-z0-9._-]{1,100}$",
      "description": "owner/name on github.com."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "static_provider": {
      "enum": ["cloudflare-pages", "github-pages", "netlify", "vercel"],
      "description": "Where a built static site is served from. A new provider is one more value here, for books and the portal at once."
    },
    "project_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$",
      "description": "The provider's name for the site: the Pages or Netlify project, or owner/repo for GitHub Pages."
    },
    "paid_by": {
      "enum": ["maintainer", "platform"],
      "description": "Whose subscription or account has to keep paying for the site to stay up. The account itself is never recorded: it is identified by an email address, and nothing here may be non-public."
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!-)(?!.*\\.\\.)(?!.*//)(?!.*\\.lock$)[A-Za-z0-9._/-]+(?<![./])$"
    },

    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug", "status", "title", "summary", "licence", "maintainer",
        "content", "site", "analytics", "annotations", "suggest_edit", "cms", "editions"
      ],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "status": { "enum": ["preview", "live", "retired"] },

        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "licence": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+$",
          "description": "SPDX identifier."
        },
        "maintainer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "github"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "github": { "oneOf": [{ "$ref": "#/$defs/github_login" }, { "type": "null" }] }
          }
        },

        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "live_branch", "drafts_branch"],
          "properties": {
            "repo": { "$ref": "#/$defs/repo" },
            "live_branch": { "$ref": "#/$defs/branch" },
            "drafts_branch": { "$ref": "#/$defs/branch" }
          }
        },

        "site": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "host", "legacy_origins"],
          "properties": {
            "domain": { "oneOf": [{ "$ref": "#/$defs/hostname" }, { "type": "null" }] },
            "aliases": {
              "type": "array",
              "items": { "$ref": "#/$defs/hostname" },
              "uniqueItems": true,
              "description": "Redirect-only hostnames, such as a courtesy <slug>.<portal>. Never an accepted origin. Absent means none."
            },
            "host": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "site_id", "publish_host"],
                  "properties": {
                    "kind": { "const": "obsidian-publish" },
                    "site_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
                    "publish_host": { "$ref": "#/$defs/hostname" },
                    "paid_by": { "$ref": "#/$defs/paid_by" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "provider", "project"],
                  "properties": {
                    "kind": { "const": "static" },
                    "provider": { "$ref": "#/$defs/static_provider" },
                    "project": { "$ref": "#/$defs/project_name" },
                    "paid_by": { "$ref": "#/$defs/paid_by" },
                    "builder": {
                      "enum": ["quartz-book"],
                      "description": "The platform builder that builds and deploys this book (BOOK-ONE-TO-QUARTZ §0, §0a). Absent means the builder leaves the book alone: it is built somewhere else, by whoever maintains it. A builder book's content repo must be readable anonymously, which check-github.mjs enforces."
                    }
                  }
                }
              ]
            },
            "legacy_origins": {
              "type": "array",
              "items": { "$ref": "#/$defs/https_origin" },
              "uniqueItems": true
            },
            "dark": {
              "description": "Declared by the platform owner, by PR, once the site is gone and its hostname parked (MULTI-BOOK-HOSTING §5d). Not observed health, and not a status: status stays preview | live | retired. null or absent means not declared dark.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["since", "reason", "notified"],
                  "properties": {
                    "since": { "$ref": "#/$defs/date" },
                    "reason": { "enum": ["subscription-lapsed", "domain-removed", "maintainer-request", "unknown"] },
                    "notified": {
                      "description": "When the maintainer was told. null if they could not be reached.",
                      "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
                    }
                  }
                }
              ]
            }
          }
        },

        "analytics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plausible"],
          "properties": {
            "plausible": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["script_src", "site", "dashboard_public"],
                  "properties": {
                    "script_src": {
                      "type": "string",
                      "pattern": "^https://plausible\\.io/js/[A-Za-z0-9._-]+\\.js$"
                    },
                    "site": {
                      "$ref": "#/$defs/hostname",
                      "description": "The site's name in the Plausible account. The public dashboard's address is derived from it, https://plausible.io/<site>, and is never stored."
                    },
                    "dashboard_public": {
                      "type": "boolean",
                      "description": "Whether https://plausible.io/<site> is viewable logged out. The vault's community dashboard links readership there only when this is true."
                    }
                  }
                }
              ]
            }
          }
        },

        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hypothesis_groups"],
          "properties": {
            "hypothesis_groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[A-Za-z0-9]{8}$" },
                  "label": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },

        "suggest_edit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "counted_from"],
          "properties": {
            "enabled": { "type": "boolean" },
            "counted_from": {
              "description": "First day (UTC) whose suggestions are reader activity. Issues filed earlier were tests of the route and are left out of public counts. null counts everything.",
              "oneOf": [
                { "$ref": "#/$defs/date" },
                { "type": "null" }
              ]
            }
          }
        },

        "cms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "host"],
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "oneOf": [{ "$ref": "#/$defs/hostname" }, { "type": "null" }] }
          }
        },

        "editions": {
          "description": "Department editions: forks of an edition template repo. null for a book that has none.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["template_repo", "template_preview", "skip_fork_owners"],
              "properties": {
                "template_repo": { "$ref": "#/$defs/repo" },
                "template_preview": { "oneOf": [{ "$ref": "#/$defs/https_origin" }, { "type": "null" }] },
                "skip_fork_owners": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/github_login" },
                  "uniqueItems": true
                }
              }
            }
          ]
        }
      }
    }
  }
}
